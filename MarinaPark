#!/usr/bin/env node

const { spawn, spawnSync } = require("child_process");
const crypto = require("crypto");
const fs = require("fs");
const http = require("http");
const net = require("net");
const path = require("path");

const rootDir = __dirname;
const instancePath = path.join(rootDir, "data", "server-instance.json");
const preferredPort = Number(process.env.PORT || 4173);

function normalizedPath(value) {
  const resolved = path.resolve(String(value || ""));
  return process.platform === "win32" ? resolved.toLowerCase() : resolved;
}

function processExists(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function requestJson(url, timeout = 1500) {
  return new Promise((resolve, reject) => {
    const request = http.get(url, (response) => {
      const chunks = [];
      response.on("data", (chunk) => chunks.push(chunk));
      response.on("end", () => {
        try {
          resolve(JSON.parse(Buffer.concat(chunks).toString("utf8")));
        } catch (error) {
          reject(error);
        }
      });
    });
    request.on("error", reject);
    request.setTimeout(timeout, () => request.destroy(new Error("timeout")));
  });
}

async function stopExistingInstance() {
  let instance;
  try {
    instance = JSON.parse(fs.readFileSync(instancePath, "utf8"));
  } catch {
    return;
  }

  const pid = Number(instance.pid);
  const port = Number(instance.port);
  if (!Number.isInteger(pid) || !Number.isInteger(port) || !instance.token || !processExists(pid)) {
    fs.rmSync(instancePath, { force: true });
    return;
  }

  try {
    const running = await requestJson(`http://127.0.0.1:${port}/api/instance`);
    const belongsToThisInstall =
      running.token === instance.token &&
      Number(running.pid) === pid &&
      normalizedPath(running.installDirectory) === normalizedPath(rootDir);
    if (!belongsToThisInstall) return;

    console.log(`Se oprește instanța anterioară Marina Park (PID ${pid})...`);
    process.kill(pid);
    for (let attempt = 0; attempt < 30 && processExists(pid); attempt += 1) {
      await new Promise((resolve) => setTimeout(resolve, 100));
    }
    if (processExists(pid)) {
      throw new Error(`Instanța anterioară (PID ${pid}) nu s-a oprit.`);
    }
    fs.rmSync(instancePath, { force: true });
  } catch (error) {
    console.log(`Nu am putut opri instanța anterioară în siguranță: ${error.message}`);
  }
}

function npmCommand() {
  return process.platform === "win32" ? "npm.cmd" : "npm";
}

function dependenciesAreInstalled() {
  try {
    require.resolve("mysql2", { paths: [rootDir] });
    return true;
  } catch {
    return false;
  }
}

function ensureDependencies() {
  if (dependenciesAreInstalled()) {
    return;
  }

  if (!fs.existsSync(path.join(rootDir, "package.json"))) {
    throw new Error("Nu găsesc package.json lângă launcher.");
  }

  console.log("Se instalează dependențele aplicației...");
  const install = spawnSync(npmCommand(), ["install"], {
    cwd: rootDir,
    stdio: "inherit",
    shell: false
  });

  if (install.status !== 0) {
    throw new Error("Instalarea dependențelor a eșuat. Verifică conexiunea la internet și rulează din nou launcherul.");
  }
}

function findFreePort(startPort) {
  return new Promise((resolve, reject) => {
    const tryPort = (port) => {
      if (port > 65535) {
        reject(new Error("Nu am găsit un port liber pentru aplicație."));
        return;
      }
      const server = net.createServer();
      server.once("error", (error) => {
        if (error.code === "EADDRINUSE") {
          tryPort(port + 1);
          return;
        }
        reject(error);
      });
      server.once("listening", () => {
        server.close(() => resolve(port));
      });
      server.listen(port, "127.0.0.1");
    };

    tryPort(startPort);
  });
}

async function waitForServer(url, expectedToken, attempts = 80) {
  for (let remaining = attempts; remaining >= 0; remaining -= 1) {
    try {
      const instance = await requestJson(`${url}/api/instance`, 1000);
      if (
        instance.token === expectedToken &&
        normalizedPath(instance.installDirectory) === normalizedPath(rootDir)
      ) {
        return instance;
      }
    } catch {
      // The child process may still be starting.
    }
    if (remaining > 0) {
      await new Promise((resolve) => setTimeout(resolve, 250));
    }
  }
  throw new Error(`Serverul corect nu a pornit la ${url}`);
}

function openBrowser(url) {
  if (process.env.MARINA_NO_BROWSER === "1") {
    return;
  }

  const platform = process.platform;
  const command =
    platform === "win32"
      ? "cmd"
      : platform === "darwin"
        ? "open"
        : "xdg-open";
  const args = platform === "win32" ? ["/c", "start", "", url] : [url];
  const opener = spawn(command, args, {
    detached: true,
    stdio: "ignore"
  });
  opener.on("error", () => {
    console.log(`Deschide manual în browser: ${url}`);
  });
  opener.unref();
}

async function main() {
  ensureDependencies();
  await stopExistingInstance();
  const port = await findFreePort(preferredPort);
  const url = `http://localhost:${port}`;
  const instanceToken = crypto.randomUUID();
  const server = spawn(process.execPath, ["--no-warnings", "server.js"], {
    cwd: rootDir,
    env: {
      ...process.env,
      PORT: String(port),
      MARINA_INSTANCE_TOKEN: instanceToken
    },
    stdio: "inherit"
  });

  const stopServer = () => {
    if (!server.killed) {
      server.kill();
    }
  };

  process.on("SIGINT", stopServer);
  process.on("SIGTERM", stopServer);
  process.on("exit", stopServer);

  server.on("exit", (code) => {
    process.exit(code || 0);
  });

  const activeInstance = await waitForServer(url, instanceToken);
  console.log(`Instanță verificată: Marina Park ${activeInstance.version} din ${activeInstance.installDirectory}`);
  console.log(`Se deschide Marina Park: ${url}`);
  openBrowser(url);
}

main().catch((error) => {
  console.error(error.message || error);
  process.exit(1);
});
